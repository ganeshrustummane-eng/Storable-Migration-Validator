# Copy this file to .env (local), .env.dev, .env.uat, or .env.prod and fill
# in real values. These files are gitignored (except this .example) — never
# commit real credentials.
#
# This is the single credential format used by both the webapp/src connector
# AND Project/main.py's YAML-driven validation runner — no separate creds
# YAML files anymore. --environment local|dev|uat|prod picks which of these
# files gets loaded.

# ── AI backend (one of these) ────────────────────────────────────────────
DIAL_API_KEY=
DIAL_API_BASE=
DIAL_API_VERSION=
DIAL_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative to GEMINI_API_KEY/GOOGLE_API_KEY above — use this instead when
# your GCP project disables personal Gemini Developer API key creation by org
# policy (common in corporate-governed projects). Authenticates via
# Application Default Credentials (ADC), not a key.
#   Local:     gcloud auth application-default login
#   Cloud Run: uses the service's own runtime service account automatically —
#              just grant it roles/aiplatform.user and enable
#              aiplatform.googleapis.com on the project.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ── Source connections — SRC_N_* (N = 1, 2, 3, ...), one block per source ──
# TYPE is one of: postgresql | mssql | athena | redshift

SRC_1_TYPE=postgresql
SRC_1_HOST=
SRC_1_PORT=5432
SRC_1_DATABASE=
SRC_1_SCHEMA=public
SRC_1_USERNAME=
SRC_1_PASSWORD=

SRC_2_TYPE=mssql
SRC_2_HOST=
SRC_2_PORT=1433
SRC_2_DATABASE=
SRC_2_SCHEMA=dbo
SRC_2_USERNAME=
SRC_2_PASSWORD=
SRC_2_AUTH=
# Optional — defaults to "ODBC Driver 18 for SQL Server" if omitted:
SRC_2_DRIVER=

SRC_3_TYPE=athena
SRC_3_REGION=us-west-2
SRC_3_DATABASE=
SRC_3_SCHEMA=
SRC_3_USERNAME=
SRC_3_PASSWORD=
SRC_3_QUERY_RESULT_LOCATION=s3://your-athena-query-results-bucket/

# Redshift speaks the PostgreSQL wire protocol (psycopg2) — same shape as
# SRC_1, just a different default port (5439 instead of 5432).
SRC_4_TYPE=redshift
SRC_4_HOST=
SRC_4_PORT=5439
SRC_4_DATABASE=
SRC_4_SCHEMA=public
SRC_4_USERNAME=
SRC_4_PASSWORD=

# ── Snowflake target ──────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Optional — only needed if your user has no default warehouse:
SNOWFLAKE_WAREHOUSE=

# ── JIRA Integration (optional) ──────────────────────────────────────────
# Enables automatic ticket creation for rejected mappings and validation failures.
# Leave blank to disable JIRA integration.
#
# Setup instructions:
#   1. Generate API token: https://id.atlassian.com/manage-profile/security/api-tokens
#   2. Fill in your JIRA Cloud instance URL (no trailing slash)
#   3. Use your JIRA account email
#   4. Paste the API token
#   5. Set project key where migration tickets should be created
#
# Test configuration: python verify_jira_config.py --create-test-ticket
# Full docs: docs/deployment/jira-integration.md

# ── Failure notifications (optional) ─────────────────────────────────────
# Slack: create an incoming webhook at api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Email: comma-separated recipients
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=migration-validator@yourcompany.com
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── JIRA Integration (optional) ──────────────────────────────────────────
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=MIG
# Optional — defaults to "Task":
JIRA_ISSUE_TYPE=Task
