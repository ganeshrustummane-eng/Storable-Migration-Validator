{"nodes": [{"id": "decisions_0001_pyspark_vs_streaming_chunking", "label": "Use streaming/chunked reads + hash-narrowing instead of a PySpark cluster", "file_type": "rationale", "source_file": "docs/decisions/0001-pyspark-vs-streaming-chunking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 200-300M rows the validator can't hold full source+target+result in memory. Rather than adopting a Spark cluster (new infra, would require re-proving correctness rules like dup-key/PK-less/JSON-hstore canonicalization in Spark's API), stream reads in bounded chunks per connector and use a cheap hash pre-filter (Tier 1) to narrow expensive exact Python comparison (Tier 2) to only disagreeing rows. Rejected chunked-fetch-only (still moves 100% of bytes through compare stage) and DB-side hashing as final answer (no SQL dialect reproduces Python-side JSON/decimal canonicalization identically across all four sources) \u2014 hash used only as a safe pre-filter."}, {"id": "tier1_tier2_hybrid_strategy", "label": "Tier-1/Tier-2 hybrid hash-narrowing execution strategy", "file_type": "concept", "source_file": "docs/decisions/0001-pyspark-vs-streaming-chunking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "decisions_0001_pyspark_vs_streaming_chunking", "target": "tier1_tier2_hybrid_strategy", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-pyspark-vs-streaming-chunking.md", "source_location": null, "weight": 1.0}, {"source": "decisions_0001_pyspark_vs_streaming_chunking", "target": "project_main_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-pyspark-vs-streaming-chunking.md", "source_location": null, "weight": 1.0}, {"source": "decisions_0001_pyspark_vs_streaming_chunking", "target": "decisions_0002_table_level_thread_pool_parallelism", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-pyspark-vs-streaming-chunking.md", "source_location": null, "weight": 1.0}, {"source": "decisions_0001_pyspark_vs_streaming_chunking", "target": "decisions_0004_run_validation_hang_subprocess_pipe_deadlock", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/decisions/0001-pyspark-vs-streaming-chunking.md", "source_location": null, "weight": 1.0}], "hyperedges": []}